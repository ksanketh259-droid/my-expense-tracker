# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit the real ".env" file to GitHub.

# Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API -> "anon" / "publishable" key
# This key is PUBLIC by design. Security comes from Row Level Security.
# Do NOT use the service_role / secret key anywhere in this project.
SUPABASE_ANON_KEY=your-anon-public-key

# Local server port
PORT=3000
